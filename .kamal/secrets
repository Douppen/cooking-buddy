# Deploy secrets, read from the environment. Nothing secret lives in this file.
#
# CI: GitHub Actions sets these from repo secrets (see .github/workflows/deploy.yml).
#   KAMAL_REGISTRY_PASSWORD  = the job's GITHUB_TOKEN
#   TLS_CERTIFICATE_PEM      = Cloudflare origin cert for simonnars.com
#   TLS_PRIVATE_KEY_PEM      = its private key
#   GOOGLE_CREDENTIALS_B64   = base64 of the cooking-buddy service account JSON key
# Laptop (break-glass only): export the same four before running kamal.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
TLS_CERTIFICATE_PEM=$TLS_CERTIFICATE_PEM
TLS_PRIVATE_KEY_PEM=$TLS_PRIVATE_KEY_PEM
GOOGLE_CREDENTIALS_B64=$GOOGLE_CREDENTIALS_B64
